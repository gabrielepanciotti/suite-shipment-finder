{
  "schemaVersion": "2.0",
  "name": "ShipmentFinder",
  "slug": "shipmentfinder",
  "type": "fastapi-react-app",
  "hostBase": "shipmentfinder.life.local",
  "inherits": "../Life/node.config",
  "taxonomy": {
    "id": "shipmentFinder",
    "cluster": [
      "Home"
    ],
    "displayName": "ShipmentFinder",
    "commercial": false
  },
  "tooling": {},
  "capabilities": [
    "shipping-quotes",
    "price-comparison",
    "web-bots",
    "build",
    "test",
    "deploy"
  ],
  "agents": {
    "archetypes": []
  },
  "mcp": {
    "toolsets": []
  },
  "children": [],
  "deploy": {
    "backendPkg": "shipmentfinder_backend"
  },
  "famiglia": "finder",
  "vista": {
    "sezioni": [
      { "id": "cerca", "titolo": "Cerca", "min": "player" },
      { "id": "risultati", "titolo": "Risultati", "min": "player" },
      { "id": "salvati", "titolo": "Salvati", "min": "player" },
      { "id": "impostazioni", "titolo": "Impostazioni", "min": "admin" }
    ],
    "azioni": { "ricerca.crea": "creator", "ricerca.elimina": "admin", "salvato.crea": "creator", "salvato.modifica": "creator", "salvato.elimina": "creator", "impostazioni.modifica": "admin" }
  }
}
